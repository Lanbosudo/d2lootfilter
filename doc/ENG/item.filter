    #Type Scroll of Town Portal, Scroll of Identify
    Code tsc, isc, gld

#show keys
Show
    #Type Key
    Code key

#show arrows and bolts if you are an amazon
Show
    #Type Arrows, Bolts
    Code aqv, cqv
    PlayerClass 0
# 0x00：Amazon (亚马逊)
# 0x01：Sorceress (法师)
# 0x02：Necromancer (死灵法师)
# 0x03：Paladin (圣骑士)
# 0x04：Barbarian (野蛮人)
# 0x05：Druid (德鲁伊)
# 0x06：Assassin (刺客)

